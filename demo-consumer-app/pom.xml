<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        This is a STANDALONE Spring Boot application — it is NOT part of
        the jwt-auth-starter-parent multi-module project.

        It exists only to demonstrate how to consume the starter library.
        Run "mvn clean install" on jwt-auth-starter-parent FIRST,
        then run this app.
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>demo-consumer-app</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Demo Consumer App</name>
    <description>Sample app showing jwt-auth-starter in action</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <!-- ════════════════════════════════════════════════════
             ONE DEPENDENCY = FULL JWT SECURITY
             (Pulls in: security, jjwt, filter, token provider)
             ════════════════════════════════════════════════════ -->
        <dependency>
            <groupId>com.devlib</groupId>
            <artifactId>jwt-auth-starter</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- App's own dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- H2 in-memory DB for demo purposes -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
